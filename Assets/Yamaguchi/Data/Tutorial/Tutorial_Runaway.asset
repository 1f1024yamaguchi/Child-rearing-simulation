    imageNote: "\u3053\u3069\u3082\u304C\u80CC\u3092\u5411\u3051\u3066\u5BB6\u304B\u3089\u51FA\u3066\u3044\u308B\u30C9\u30C3\u30C8\u7D75\u3002\n\u5915\u65E5\u306B\u5411\u304B\u3063\u3066\u6B69\u3044\u3066\u3044\u308B\u3002\n\u3053\u306E\u753B\u50CF\u306F\u5B9F\u969B\u306E\u5BB6\u3067\u30A4\u30D9\u30F3\u30C8\u3067\u51FA\u3066\u304F\u308B"
