    body: "\u5B50\u3069\u3082\u306E\u30B9\u30C8\u30EC\u30B9\u304C\u305A\u3063\u3068\u9AD8\u3044\u72B6\u614B\u3060\u3068\u5BB6\u51FA\u3092\u3057\u3066\u3057\u307E\u3044\u307E\u3059\uFF01\n\u5BB6\u51FA\u306E\u6642\u70B9\u3067\u30B2\u30FC\u30E0\u306F\u7D42\u4E86\u3067\u3059\u306E\u3067\u3001\u3053\u307E\u3081\u306B\u30C1\u30A7\u30C3\u30AF\u3057\u3066\u3042\u3052\u3066\u304F\u3060\u3055\u3044\uFF01\n\uFF08\u3053\u306E\u30A4\u30D9\u30F3\u30C8\u306F\u4E2D\u5B66\u751F\u306B\u306A\u3063\u3066\u304B\u3089\u8D77\u3053\u308A\u307E\u3059\uFF09"
